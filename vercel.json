{
  "version": 2,
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "api/_lib/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|api$).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup-audit-logs",
      "schedule": "0 3 * * *"
    }
  ]
}
