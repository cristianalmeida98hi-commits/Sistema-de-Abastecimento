rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Regra específica para fotos de defeitos anexadas a máquinas/veículos
    match /defeitos/{issueId}/{photoId} {
      // Leitura permitida para usuários autenticados do sistema AndradeAgro
      allow read: if request.auth != null;
      // Escrita restrita a fotos de até 5MB com mimetype de imagem por usuário autenticado
      allow write: if request.auth != null 
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      // Exclusão permitida ao resolver defeito por usuário autenticado
      allow delete: if request.auth != null;
    }
  }
}
